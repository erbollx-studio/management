# Supabase project credentials.
# Both values are safe to ship in the client bundle: the publishable key only
# grants what row-level security allows. The service role key must never
# appear here -- it belongs in Edge Function secrets (phase 1+).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
